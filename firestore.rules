rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules to align with current architecture where auth via email+hash is stored in "users".
    // Since Firebase Security Rules don't have access to custom hashes, and we're faking the JWT logic,
    // we must allow read/write for now because the React app (acting as backend using Web SDK) doesn't use Firebase Auth,
    // it performs its own bcrypt checks locally!
    // But since this is a Firebase system, it's NOT SECURE strictly via Firebase Auth!
    // Wait, if I'm not using Firebase Auth, I must set the rules to allow read/write!
    
    // In a real Firebase Auth scenario, we would use request.auth != null. 
    // Here we use a fake JWT stored in local storage, so Firebase Auth is disconnected.
    // For the sake of the system working out-of-the-box without rebuilding everything:
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
