// This is your Prisma schema file.
// For the AI Studio preview environment, we use SQLite.
// IMPORTANT: Before deploying to Hostinger, uncomment the MySQL datasource block 
// and comment out the SQLite one.

// datasource db {
//   provider = "mysql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol          String   // "ADMIN", "RECEPCIONISTA", "TECNICO"
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ots          OrdenTrabajo[] @relation("AssignedTech")
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  email     String?
  tipo      String   @default("PARTICULAR") // PARTICULAR, FLOTILLA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehiculos Vehiculo[]
  ots       OrdenTrabajo[]
  presupuestos Presupuesto[]
}

model Aseguradora {
  id               String   @id @default(cuid())
  nombre           String
  telefono         String?
  ejecutivoNombre  String?
  email            String?
  condicionesPago  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  siniestros       Siniestro[]
  ots              OrdenTrabajo[]
}

model Vehiculo {
  id          String   @id @default(cuid())
  marca       String
  modelo      String
  anio        Int
  color       String
  placas      String
  vin         String?
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ots           OrdenTrabajo[]
  presupuestos  Presupuesto[]
}

model OrdenTrabajo {
  id             String   @id @default(cuid())
  folio          String   @unique // Ej: OT-2025-0001
  origen         String   // DIRECTO, SEGURO_FLUJO_A, SEGURO_FLUJO_B, PRESUPUESTO
  presupuestoId  String?  @unique
  presupuesto    Presupuesto? @relation(fields: [presupuestoId], references: [id])
  
  // Relaciones Base
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  vehiculoId     String
  vehiculo       Vehiculo @relation(fields: [vehiculoId], references: [id])
  tecnicoId      String?
  tecnico        User?    @relation("AssignedTech", fields: [tecnicoId], references: [id])
  
  // Si viene por Seguro
  aseguradoraId  String?
  aseguradora    Aseguradora? @relation(fields: [aseguradoraId], references: [id])
  siniestro      Siniestro?
  
  kilometraje    Int?
  descripcion    String
  
  // Finanzas Base
  montoCotizado  Float    @default(0)
  montoCobrado   Float    @default(0)
  quienPaga      String   @default("CLIENTE") // CLIENTE, ASEGURADORA
  
  // Arquitectura futura: rentabilidad
  costoMateriales Float?
  costoManoObra   Float?
  utilidad        Float?
  
  fechaIngreso   DateTime @default(now())
  fechaEstimada  DateTime?
  estado         String   // INGRESADO, EN_DIAGNOSTICO, EN_PROCESO, LISTO, ENTREGADO, CANCELADO, COTIZACION_ENVIADA, APROBADA
  
  notasInternas  String?
  fotosIngreso   String?  // JSON text or comma separated URLs
  fotosEntrega   String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  materiales     Material[]
  cambiosEstado  CambioEstado[]
  pagos          Pago[]
  gastos         Gasto[]
  garantia       Garantia?
  reclamaciones  ReclamacionGarantia[]
  evidencias     Evidencia[]
}

model Presupuesto {
  id              String         @id @default(cuid())
  folio           String         @unique
  placas          String
  descripcionDano String
  montoEstimado   Float          @default(0)
  estado          String         @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  
  clienteNombre   String?
  clienteTelefono String?

  clienteId       String?
  cliente         Cliente?       @relation(fields: [clienteId], references: [id])
  vehiculoId      String?
  vehiculo        Vehiculo?      @relation(fields: [vehiculoId], references: [id])
  
  ordenTrabajo    OrdenTrabajo?

  evidencias      Evidencia[]

  createdAt       DateTime       @default(now())
  vigenteHasta    DateTime?
}

model Evidencia {
  id              String         @id @default(cuid())
  urlBase64       String         // Base64 string
  descripcion     String?
  
  presupuestoId   String?
  presupuesto     Presupuesto?   @relation(fields: [presupuestoId], references: [id])
  
  ordenTrabajoId  String?
  ordenTrabajo    OrdenTrabajo?  @relation(fields: [ordenTrabajoId], references: [id])
  
  createdAt       DateTime       @default(now())
}

model Siniestro {
  id             String   @id @default(cuid())
  numero         String
  ajustador      String?
  montoAutorizado Float?
  documentos     String?  // JSON URLs
  ordenTrabajoId String   @unique
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  aseguradoraId  String
  aseguradora    Aseguradora  @relation(fields: [aseguradoraId], references: [id])
}

model Material {
  id             String   @id @default(cuid())
  nombre         String
  cantidad       Int      @default(1)
  costoUnitario  Float
  ordenTrabajoId String
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
}

model CambioEstado {
  id             String   @id @default(cuid())
  estadoAnterior String?
  estadoNuevo    String
  usuarioId      String?
  ordenTrabajoId String
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Pago {
  id             String   @id @default(cuid())
  monto          Float
  metodo         String   // EFECTIVO, TRANSFERENCIA, TARJETA
  pagador        String   // CLIENTE, ASEGURADORA
  ordenTrabajoId String
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
  fecha          DateTime @default(now())
}

model Gasto {
  id             String   @id @default(cuid())
  descripcion    String
  monto          Float
  categoria      String   // REFACCIONES, RENTA, NOMINA, SERVICIOS, HERRAMIENTAS, OTROS
  metodoPago     String   // EFECTIVO, TRANSFERENCIA, TARJETA
  fecha          DateTime @default(now())
  ordenTrabajoId String?
  ordenTrabajo   OrdenTrabajo? @relation(fields: [ordenTrabajoId], references: [id])
}

model Garantia {
  id             String   @id @default(cuid())
  tipo           String   // PINTURA, HOJALATERIA, MECANICA, OTRO
  vigenciaDias   Int
  fechaVencimiento DateTime
  ordenTrabajoId String   @unique
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model ReclamacionGarantia {
  id             String   @id @default(cuid())
  descripcion    String
  fotos          String?
  resolucion     String?
  costoAbsorbido Float    @default(0)
  costoCobrado   Float    @default(0)
  ordenTrabajoId String
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
  createdAt      DateTime @default(now())
}

model Configuracion {
  id             String   @id @default(cuid()) // Solo un record
  nombre         String   @default("Mi Taller")
  logoUrl        String?
  direccion      String?
  telefono       String?
  rfc            String?
}

model PlantillaMensaje {
  id             String   @id @default(cuid())
  triggerEstado  String   @unique
  mensaje        String
}
